                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{newItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{newItemId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Два джойстики\"\n}",
