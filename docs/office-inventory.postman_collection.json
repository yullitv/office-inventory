        {
          "name": "Issue item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans",
              "host": ["{{baseUrl}}"],
              "path": ["loans"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": 2,\n  \"employeeId\": 1,\n  \"dueDate\": \"{{dueDate}}\",\n  \"note\": \"Для конференції\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const loan = pm.response.json();",
                  "pm.test('not returned yet', () => pm.expect(loan.returnedAt).to.be.null);",
                  "pm.test('not overdue', () => pm.expect(loan.isOverdue).to.be.false);",
                  "pm.collectionVariables.set('loanId', loan.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 7);",
                  "const pad = (n) => String(n).padStart(2, '0');",
                  "pm.collectionVariables.set('dueDate', `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`);",
                  "const past = new Date();",
                  "past.setDate(past.getDate() - 1);",
                  "pm.collectionVariables.set('pastDate', `${past.getFullYear()}-${pad(past.getMonth() + 1)}-${pad(past.getDate())}`);"
                ]
              }
            }
          ]
        },
