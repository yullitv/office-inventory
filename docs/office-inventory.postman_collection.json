                  "pm.test('description updated', () => pm.expect(item.description).to.eql('Два джойстики'));",
                  "pm.test('status untouched', () => pm.expect(item.status).to.eql('available'));",
                  "pm.test('name untouched', () => pm.expect(item.name).to.eql('Nintendo Switch'));"
                ]
